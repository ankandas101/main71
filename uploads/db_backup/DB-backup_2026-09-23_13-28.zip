) ENGINE=InnoDB AUTO_INCREMENT=2 DEFAULT CHARSET=utf8mb3 COLLATE=utf8mb3_general_ci;

INSERT INTO `front_cms_exam_results` (`id`, `page_title`, `grade_scale`, `attendance`, `banner_image`, `description`, `meta_description`, `meta_keyword`, `branch_id`) VALUES (1, 'Exam Results', 1, 1, 'exam_results1.jpg', '<p style=\"margin-bottom: 1rem; color: rgb(35, 35, 35); font-family: Raleway, sans-serif; font-size: 17px;\">পরীক্ষার রেজাল্ট দেখতে এক্সাম অপশনে আপনার পরীক্ষা সিলেক্ট করুন ।আপনার&nbsp;রেজিস্ট্রেশন নাম্বার দিয়ে সাবমিট করুন ।</p>', 'Best School Management System to manage admissions, attendance, exams, fees, results and administration easily with a secure, smart and user-friendly school ERP.', 'school management system, school ERP software, education management system, student management software, online school management system, school ERP Bangladesh ', 1);


#
# TABLE STRUCTURE FOR: front_cms_faq
#

DROP TABLE IF EXISTS `front_cms_faq`;

CREATE TABLE `front_cms_faq` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `title` varchar(255) DEFAULT NULL,
  `description` text DEFAULT NULL,
  `page_title` varchar(255) DEFAULT NULL,
  `banner_image` varchar(255) DEFAULT NULL,
  `meta_description` text NOT NULL,
  `meta_keyword` text NOT NULL,
  `branch_id` int(11) NOT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=2 DEFAULT CHARSET=utf8mb3 COLLATE=utf8mb3_general_ci;

INSERT INTO `front_cms_faq` (`id`, `title`, `description`, `page_title`, `banner_image`, `meta_description`, `meta_keyword`, `branch_id`) VALUES (1, 'Frequently Asked Questions', '<p>কমলগঞ্জ আইডিয়াল হাই স্কুল ম্যানেজমেন্ট সফটওয়্যার এর আপনার প্রাথমিক সমাধানের জন্য নিচের প্রশ্নগুলো চেক করুন ।&nbsp;এছাড়া কোন ধরনের সমস্যা&nbsp;সমাধানের জন্য আপনার শ্রেণি শিক্ষকের সাথে যোগাযোগ করুন ।&nbsp;</p>', 'Faq', 'faq1.jpg', 'Best School Management System by ankandas to manage admissions, attendance, exams, fees, results and administration easily with a secure, smart and user-friendly school ERP.', 'kamalganjidealhighschool School Management System By Ankan Das , khulna, Bangladesh. ankandas.me , ankandas.fb ', 1);


#
# TABLE STRUCTURE FOR: front_cms_faq_list
#

DROP TABLE IF EXISTS `front_cms_faq_list`;

CREATE TABLE `front_cms_faq_list` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `title` varchar(255) DEFAULT NULL,
  `description` text DEFAULT NULL,
  `branch_id` int(11) NOT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=6 DEFAULT CHARSET=utf8mb3 COLLATE=utf8mb3_general_ci;

INSERT INTO `front_cms_faq_list` (`id`, `title`, `description`, `branch_id`) VALUES (1, 'কিভাবে সফটওয়্যার ব্যবহার করবো ?', '<p>আমাদের সফটওয়্যারটি ব্যবহার করতে হলে প্রথমে আপনাকে রেজিস্ট্রেশন করতে হবে । রেজিস্ট্রেশন সম্পন্ন করতে আপনার শ্রেণি  শিক্ষকের সাথে যোগাযোগ করুন । রেজিস্ট্রেশন করা হয়ে গেলে লগইন অপশনে আপনার ইউজারনেম এবং পাসওয়ার্ড দিয়ে লগইন করুন । ইউজারনেম এবং পাসওয়ার্ড আপনাকে ইমেইলের মাধ্যমে জানানো হবে ।</p><ul>\r\n</ul>', 1);
INSERT INTO `front_cms_faq_list` (`id`, `title`, `description`, `branch_id`) VALUES (2, 'পাসওয়ার্ড ভুলে গেলে কি করবো  ?', '<p>আপনার পাসওয়ার্ড ভুলে গেলে লগইন পেজের ফরগেট পাসওয়ার্ড অপশনে গিয়ে ইউজারনেম লিখে সাবমিট করুন ।</p><p>অথবা সরাসরি নিচের লিংকে ভিজিত করুনঃ</p><p> <a href=\"https://app.kamalganjidealhighschool.edu.bd/home/forgot\" xss=removed>https://app.kamalganjidealhighschool.edu.bd/home/forgot</a> </p><p><font color=\"#0000ff\"><b>আপনার দেওয়া ইমেইলের মাধ্যমে নতুন পাসওয়ার্ড পেয়ে যাবেন । তাই ইমেইল এর ইনবক্স এবং স্প্যাম অপশন চেক করুন </b></font></p>', 1);
INSERT INTO `front_cms_faq_list` (`id`, `title`, `description`, `branch_id`) VALUES (3, 'কিভাবে পরীক্ষার রেজাল্ট দেখবো   ?', '<p>পরীক্ষার রেজাল্ট দেখতে নিচের স্টেপ গুলো ফলো করুনঃ</p><p>১. প্রথমে এই লিংকে যান <a href=\"https://app.kamalganjidealhighschool.edu.bd/home/exam_results\">https://app.kamalganjidealhighschool.edu.bd/home/exam_results</a> </p><p>২. এক্সাম অপশনে আপনার পরীক্ষা সিলেক্ট করুন ।</p><p>৩. সেশনের বর্তমান সেশন সিলেক্ট করুন </p><p>৪. আপনার রেজিস্ট্রেশন নাম্বার দিয়ে সাবমিট করুন ।</p><p><br></p>', 1);


