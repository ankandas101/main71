#
# TABLE STRUCTURE FOR: front_cms_home
#

DROP TABLE IF EXISTS `front_cms_home`;

CREATE TABLE `front_cms_home` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `title` varchar(255) DEFAULT NULL,
  `subtitle` varchar(255) DEFAULT NULL,
  `item_type` varchar(20) NOT NULL,
  `description` text CHARACTER SET utf8mb3 COLLATE utf8mb3_unicode_ci NOT NULL,
  `elements` mediumtext NOT NULL,
  `color1` varchar(100) DEFAULT NULL,
  `color2` varchar(100) DEFAULT NULL,
  `branch_id` int(11) NOT NULL,
  `active` tinyint(3) NOT NULL DEFAULT 1,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=13 DEFAULT CHARSET=utf8mb3 COLLATE=utf8mb3_general_ci;

INSERT INTO `front_cms_home` (`id`, `title`, `subtitle`, `item_type`, `description`, `elements`, `color1`, `color2`, `branch_id`, `active`) VALUES (1, 'Welcome To Taraganj Computer Training Institute', 'We will give you future', 'wellcome', 'তারাগঞ্জ কম্পিউটার ট্রেনিং ইন্সটিটিউট (Code: 16193) রংপুর জেলার তারাগঞ্জ উপজেলার কুর্শা ইউনিয়নের তারাগঞ্জ মডের সরকারি প্রাথমিক বিদ্যালয় সংলগ্ন এলাকায় অবস্থিত একটি স্বনামধন্য কম্পিউটার শিক্ষা প্রতিষ্ঠান। প্রযুক্তির এই অগ্রযাত্রায় টিকে থাকতে হলে কম্পিউটার শিক্ষার গুরুত্ব অপরিসীম। তারাগঞ্জ কম্পিউটার ট্রেনিং ইন্সটিটিউট প্রতিষ্ঠালগ্ন থেকেই শিক্ষার্থীদের মানসম্মত ও ব্যবহারিক প্রশিক্ষণ প্রদান করে আসছে। আমাদের লক্ষ্য শুধুমাত্র সার্টিফিকেট প্রদান নয়, বরং দক্ষ, আত্মবিশ্বাসী ও কর্মমুখী মানবসম্পদ গড়ে তোলা।\r\nবর্তমান প্রতিযোগিতামূলক বিশ্বে আইটি দক্ষতা অর্জনের মাধ্যমে শিক্ষার্থীরা নিজেদের কর্মসংস্থান তৈরি করতে পারে এবং দেশের উন্নয়নে গুরুত্বপূর্ণ ভূমিকা রাখতে সক্ষম হয়। আমরা বিশ্বাস করি, সঠিক দিকনির্দেশনা ও আন্তরিক প্রচেষ্টায় আমাদের শিক্ষার্থীরা সফলতার শিখরে পৌঁছাবে।', '{\"image\":\"wellcome1.jpg\"}', '#000', NULL, 1, 1);
